(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
(deny file-read* (regex "^/Users/leehyunwoo/project/pnu-docs-chatbot/(config|docs|evidence)/.*holdout.*"))
(deny file-read* (literal "/Users/leehyunwoo/project/pnu-docs-chatbot/.env"))
(deny file-write* (subpath "/Users/leehyunwoo/project/pnu-docs-chatbot"))
(allow file-write* (subpath "/Users/leehyunwoo/project/pnu-docs-chatbot/processed/eval/preflight-20260908/security-layer-fixes-v1"))
