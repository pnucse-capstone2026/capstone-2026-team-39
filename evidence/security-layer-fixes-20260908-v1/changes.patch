+def _locally_benign(normalized: str, finding: SecurityFinding) -> bool:
+    """Exempt only a local prohibition, never a ban elsewhere in the chunk.
+
+    Existing patterns can span multiple instructions. Such matches must not
+    inherit a negation belonging to only the last instruction.
+    """
+    matched = normalized[finding.start:finding.end]
+    if _CLAUSE_BOUNDARY_RE.search(matched):
+        return False
+    if finding.category == "model_delimiter":
+        left = max((m.end() for m in _CLAUSE_BOUNDARY_RE.finditer(normalized, 0, finding.start)), default=0)
+        boundary = _CLAUSE_BOUNDARY_RE.search(normalized, finding.end)
+        right = boundary.start() if boundary else len(normalized)
+        return bool(_BENIGN_DELIMITER_CONTEXT_RE.search(normalized[left:right]))
+    if finding.category not in {"secret_exfiltration", "tool_or_network_command", "citation_manipulation"}:
+        return False
+    if finding.category == "secret_exfiltration" and len(_SECRET_ACTION_RE.findall(matched)) != 1:
+        return False
+    # No unbounded '... negation ...' search: the grammatical suffix must
+    # immediately follow this exact detected action or quoted request.
+    return bool(_BENIGN_NEGATION_SUFFIX_RE.match(normalized[finding.end:]))
 
 
