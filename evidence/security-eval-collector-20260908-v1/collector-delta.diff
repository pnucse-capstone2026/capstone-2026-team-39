 class AnswerPayloadError(RuntimeError):
     """A non-retryable malformed/empty service answer."""
+
+
+def inspect_security_response(response: dict, *, expected_mode: str) -> dict:
+    """Validate server observations, never infer security success from answer text.
+
+    response → pinned mode + gate contract → generated | security_abstention
+                                      └→ inconsistent/missing → control_error
+    Only the exact no-generation/all-contexts-excluded contract gets an exception
+    to the usual used-provider/model check. Every other control stays enforced.
+    """
+    if expected_mode not in {"absent", "enforce"}:
+        raise RuntimeError("unsupported security evaluation mode")
+    if not isinstance(response, dict):
+        raise RuntimeError("security evaluation response must be an object")
+    trace = response.get("evaluation_trace")
+    results = response.get("results")
+    if (
+        not isinstance(results, list) or not isinstance(trace, dict)
+        or trace.get("schema_version") != 1
+        or not isinstance(trace.get("retrieval_stages"), dict)
+        or not isinstance(trace["retrieval_stages"].get("final_contexts"), list)
+        or len(trace["retrieval_stages"]["final_contexts"]) != len(results)
+    ):
+        raise RuntimeError("security evaluation requires consistent final-context trace")
+    observation = {
+        "contract_version": SECURITY_EVAL_CONTRACT,
+        "expected_mode": expected_mode,
+        "outcome": "generated",
+        "generator_called": True,
+    }
+    security = response.get("security")
+    retrieval = response.get("retrieval")
+    if not isinstance(retrieval, dict):
+        raise RuntimeError("security evaluation requires retrieval metadata")
+    if expected_mode == "absent":
+        if security is not None or "security_gate" in retrieval:
+            raise RuntimeError("pre-security condition unexpectedly returned security metadata")
+        return observation
+    if not isinstance(security, dict) or set(security) != {"context_gate", "output_gate"}:
+        raise RuntimeError("security evaluation omitted gate summaries")
+    context, output = security["context_gate"], security["output_gate"]
+    if not isinstance(context, dict) or not isinstance(output, dict):
+        raise RuntimeError("invalid security gate summary types")
+    if context.get("policy_version") != "context-security-v1" or context.get("mode") != "enforce":
+        raise RuntimeError("context security policy/mode mismatch")
+    if output.get("policy_version") != "output-security-v1":
+        raise RuntimeError("output security policy mismatch")
+    if retrieval.get("security_gate") != context:
+        raise RuntimeError("context security summary disagreement")
+    for summary, keys in (
+        (context, ("evaluated", "allowed", "sanitized", "excluded")),
+        (output, ("claims_checked", "claims_supported", "invalid_citations")),
+    ):
+        for key in keys:
+            if type(summary.get(key)) is not int or summary[key] < 0:
+                raise RuntimeError(f"invalid security counter: {key}")
+    if context["evaluated"] != context["allowed"] + context["sanitized"] + context["excluded"]:
+        raise RuntimeError("inconsistent context security counts")
+    reasons = context.get("reasons")
+    if not isinstance(reasons, dict) or any(
+        not isinstance(key, str) or not key or type(value) is not int or value <= 0
+        for key, value in reasons.items()
+    ) or (context["evaluated"] > 0 and not reasons):
+        raise RuntimeError("invalid context security reasons")
+    results = response.get("results")
+    if not isinstance(results, list) or len(results) != context["allowed"] + context["sanitized"]:
+        raise RuntimeError("security counts disagree with returned contexts")
+    if context.get("status") != ("passed" if results else "blocked"):
+        raise RuntimeError("context security status mismatch")
+    decision = output.get("decision")
+    if decision not in {"answer", "partial_answer", "abstain"}:
+        raise RuntimeError("unknown output security decision")
+    if output.get("status") != ("blocked" if decision == "abstain" else "passed"):
+        raise RuntimeError("output security status mismatch")
+    if output["claims_supported"] > output["claims_checked"]:
+        raise RuntimeError("output supported claims exceed checked claims")
+    if decision != "abstain" and output["invalid_citations"]:
+        raise RuntimeError("output security passed invalid citations")
+
+    generation = response.get("generation")
+    if not isinstance(generation, dict):
+        raise RuntimeError("security evaluation omitted generation metadata")
+    if generation.get("used") != "none":
+        if not results:
+            raise RuntimeError("generation reported without any retained context")
+        return observation
+
+    # Fail closed: no_results by itself can be an ordinary search failure.
+    # Keep the actual used=none/model=None values; do not invent an LLM request.
+    if (
+        context["evaluated"] <= 0 or context["excluded"] != context["evaluated"]
+        or results or decision != "abstain"
+        or any(output[key] != 0 for key in ("claims_checked", "claims_supported", "invalid_citations"))
+        or response.get("claims") != [] or response.get("citations") != []
+        or generation.get("model") is not None
+        or generation.get("fallback_reason") != "no_results"
+        or generation.get("attempts") != []
+        or set(generation) != {"requested", "used", "model", "fallback_reason", "attempts"}
+    ):
+        raise RuntimeError("not a verified all-contexts-excluded security abstention")
+    trace = response.get("evaluation_trace")
+    if (
+        not isinstance(trace, dict) or trace.get("schema_version") != 1
+        or any(key not in trace or trace[key] is not None
+               for key in ("generation_input", "raw_draft", "sanitized_draft"))
+        or not isinstance(trace.get("retrieval_stages"), dict)
+        or trace["retrieval_stages"].get("final_contexts") != []
+    ):
+        raise RuntimeError("security abstention trace contradicts no generation")
+    observation.update(outcome="security_abstention", generator_called=False)
+    return observation
+
+
+def validate_saved_security_record(record: dict) -> None:
+    """Validate preserved metadata as well as its enclosing immutable record hash."""
+    config = record.get("collector_config") or {}
+    expected_mode = config.get("expected_security_mode")
+    response = {**record, "results": record.get("sources")}
+    expected = inspect_security_response(response, expected_mode=expected_mode)
+    if record.get("security_evaluation") != expected:
+        raise ValueError("saved security evaluation observation mismatch")
 
 
